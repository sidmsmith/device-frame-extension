{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "0.21.1",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-toolbar": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "__MSG_cmdToggleToolbar__"
    },
    "copy-screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmdCopyScreenshot__"
    },
    "record": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "__MSG_cmdRecord__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["keyguard.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["title.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["skins/*.webp"], "matches": ["<all_urls>"] }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "storage", "webNavigation", "downloads", "clipboardWrite", "tabCapture", "desktopCapture"],
  "host_permissions": ["<all_urls>"]
}
