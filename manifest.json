{
  "manifest_version": 3,
  "name": "Device Frame",
  "version": "0.7.0",
  "description": "Show the current page inside an Android phone frame for demos.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open this page in a device frame",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-toolbar": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Show/hide the control bar in the device frame window"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "storage", "webNavigation", "downloads", "clipboardWrite"],
  "host_permissions": ["<all_urls>"]
}
